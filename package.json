{
    "name": "asyl",
    "version": "1.0.3",
    "description": "Asyl - WebAssembly Async System Layer",
    "type": "module",
    "source": "./src/main.ts",
    "main": "./dist/asyl.m.js",
    "module": "./dist/asyl.m.js",
    "global": "./dist/asyl.js",
    "types": "./dist/asyl.d.ts",
    "scripts": {
        "test": "echo Ok",
        "deploy": "pnpm build && pnpm tsdoc && node ./scripts/deploy.js",
        "commit": "node ./scripts/commit.js",
        "tsdoc": "dts-bundle-generator --no-banner --disable-symlinks-following -o ./dist/asyl.d.ts ./src/main.ts",
        "changes": "rose ./scripts/changes.fn",
        "build:global": "parcel build --no-cache --target global",
        "build:module": "parcel build --no-cache --target module",
        "watch": "parcel watch --no-cache --target module --no-hmr",
        "wasm": "/dev/opt/wasi-sdk/bin/clang++ -I/dev/usr-include -nostartfiles -Wl,--no-entry -Wl,--allow-undefined -Wl,--export-dynamic -Wl,--no-check-features -Wl,-Map,src/main.map -Wl,--export-all -Wl,--shared-memory -Wl,--import-memory -Wl,--initial-memory=1048576 -Wl,--max-memory=2147483648 -flto -Wl,--lto-O3 src/main.cpp -o src/main.wasm",
        "wat": "wasm2wat --enable-threads --generate-names src/main.wasm > src/main.wat",
        "build": "pnpm build:module && pnpm build:global",
        "all": "pnpm wasm && pnpm build && pnpm tsdoc"
    },
    "targets": {
        "module": {
            "source": "./src/main.ts",
            "optimize": true
        },
        "global": {
            "source": "./src/_main.ts",
            "optimize": true,
            "includeNodeModules": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rsthn/asyl.git"
    },
    "author": "RedStar Technologies",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/rsthn/asyl/issues"
    },
    "homepage": "https://github.com/rsthn/asyl#readme",
    "files": [
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "dependencies": {
        "atob": "^2.1.2",
        "buffer": "^6.0.3"
    },
    "devDependencies": {
        "@parcel/optimizer-data-url": "^2.16.3",
        "@parcel/transformer-inline-string": "^2.16.3",
        "dts-bundle-generator": "^8.1.2",
        "parcel": "^2.16.3",
        "typescript": "^5.9.3"
    }
}
